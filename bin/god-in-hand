#!/usr/bin/env bash
# ============================================================================
# God in Hand CLI — Subcommand Router
# ============================================================================
set -o pipefail

GIH_VERSION="0.2.1"
GIH_HOME="${HOME}/.god-in-hand"
GIH_REPO="${GIH_HOME}/repo"

# If running from a local dev checkout (not installed via symlink),
# detect the repo from the script's actual location
if [[ -n "${BASH_SOURCE[0]}" ]]; then
    _SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
    if [[ -f "${_SELF_DIR}/../lib/detect.sh" ]]; then
        GIH_REPO="$(cd "${_SELF_DIR}/.." && pwd)"
    fi
    unset _SELF_DIR
fi

# ---------------------------------------------------------------------------
# Validate repo exists
# ---------------------------------------------------------------------------
if [[ ! -d "$GIH_REPO" || ! -f "${GIH_REPO}/lib/detect.sh" ]]; then
    echo "ERROR: God in Hand repository not found at ${GIH_REPO}" >&2
    echo "  Run the installer: curl -sL https://raw.githubusercontent.com/songblaq/god-in-hand/main/install.sh | bash" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Minimal color support
# ---------------------------------------------------------------------------
if [[ -t 1 ]]; then
    RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
    BLUE='\033[0;34m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; BOLD=''; NC=''
fi

# ---------------------------------------------------------------------------
# Piped install detection (for curl | bash compatibility)
# ---------------------------------------------------------------------------
PIPED_INSTALL=false
if [[ ! -t 0 ]]; then
    PIPED_INSTALL=true
    exec 3</dev/tty 2>/dev/null || exec 3</dev/null
fi

# ---------------------------------------------------------------------------
# Core utility functions (needed by subcommands)
# ---------------------------------------------------------------------------
GIH_LOG_DIR="${GIH_HOME}/logs"
GIH_LOG="${GIH_LOG_DIR}/cli-$(date +%Y%m%d-%H%M%S).log"

log() {
    local ts
    ts=$(date "+%Y-%m-%d %H:%M:%S")
    echo "[${ts}] $*" >> "$GIH_LOG" 2>/dev/null
}

die() {
    echo -e "${RED}${BOLD}ERROR:${NC} $1" >&2
    log "FATAL: $1"
    exit 1
}

print_ok()    { echo -e "  ${GREEN}✓${NC} $1"; log "OK: $1"; }
print_fail()  { echo -e "  ${RED}✗${NC} $1"; log "FAIL: $1"; }
print_warn()  { echo -e "  ${YELLOW}⚠${NC} $1"; log "WARN: $1"; }
print_info()  { echo -e "  ${CYAN}ℹ${NC} $1"; log "INFO: $1"; }
print_step()  { echo -e "\n${BOLD}${BLUE}━━━ $1 ━━━${NC}"; log "STEP: $1"; }

ask_yn() {
    local prompt="$1"
    local default="${2:-y}"
    local answer
    echo -ne "  ${prompt} "
    if $PIPED_INSTALL; then
        read -r answer <&3 || answer="$default"
    else
        read -r answer
    fi
    answer="${answer:-$default}"
    [[ "${answer,,}" == "y" || "${answer,,}" == "yes" ]]
}

read_input() {
    local var_name="$1"
    if $PIPED_INSTALL; then
        # shellcheck disable=SC2229
        # SECURITY: Use printf -v for safe indirect assignment (eval would allow injection)
        read -r "$var_name" <&3 || printf -v "$var_name" ''
    else
        # shellcheck disable=SC2229
        read -r "$var_name"
    fi
}

run_cmd() {
    local desc="$1"
    shift
    log "CMD: $*"
    if ${DRY_RUN:-false}; then
        print_info "[dry-run] ${desc}: $*"
        return 0
    fi
    local output
    output=$("$@" 2>&1)
    local rc=$?
    if [[ $rc -ne 0 ]]; then
        log "CMD FAILED (rc=${rc}): ${output}"
        echo "$output" >> "$GIH_LOG"
    fi
    return $rc
}

# ---------------------------------------------------------------------------
# Source shared libraries
# ---------------------------------------------------------------------------
source "${GIH_REPO}/lib/i18n.sh"
source "${GIH_REPO}/lib/detect.sh"

# ---------------------------------------------------------------------------
# show_help — Display usage information
# ---------------------------------------------------------------------------
show_help() {
    echo "God in Hand v${GIH_VERSION} — On-device AI Agent System"
    echo ""
    echo "Usage: god-in-hand <command> [options]"
    echo ""
    echo "Commands:"
    echo "  setup, install    Full installation (Phase 0-5)"
    echo "  clear, clean      Remove installation data, stop services"
    echo "  update            Update CLI and repo to latest version"
    echo "  health            Run health check diagnostics"
    echo "  version, -v       Show version"
    echo "  help, -h          Show this help message"
    echo ""
    echo "Examples:"
    echo "  god-in-hand setup --lang ko --engine ollama"
    echo "  god-in-hand clear --force"
    echo "  god-in-hand update"
    echo ""
    echo "Docs: https://github.com/songblaq/god-in-hand"
}

# ---------------------------------------------------------------------------
# Route subcommand
# ---------------------------------------------------------------------------
case "${1:-help}" in
    setup|install)
        source "${GIH_REPO}/lib/cmd_setup.sh"
        cmd_setup "${@:2}"
        ;;
    clear|clean)
        source "${GIH_REPO}/lib/cmd_clear.sh"
        cmd_clear "${@:2}"
        ;;
    update)
        source "${GIH_REPO}/lib/cmd_update.sh"
        cmd_update "${@:2}"
        ;;
    health)
        source "${GIH_REPO}/lib/health.sh"
        run_full_health_check
        ;;
    version|-v|--version)
        echo "God in Hand v${GIH_VERSION}"
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo ""
        show_help
        exit 1
        ;;
esac
